# AINative API Key (recommended - get from https://ainative.studio/dashboard)
AINATIVE_API_KEY=ak_your_key_here

# OR username/password
# AINATIVE_USERNAME=you@example.com
# AINATIVE_PASSWORD=your_password

# API endpoint (auto-detected: tries localhost:8000 first, falls back to cloud)
# AINATIVE_API_URL=https://api.ainative.studio
